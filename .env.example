# Discord
DISCORD_TOKEN=

# API
PORT=3000
MAX_LENGTH=500
CALL_PREFIX_TEXT=Sent from Midnight Labs. SmartBoot:

# Local Piper TTS
PIPER_BIN=/opt/piper/bin/piper
PIPER_MODEL=/app/models/en_US-lessac-medium.onnx

# SIP provider
SIP_SERVER=
SIP_SERVER_PORT=5060
SIP_DOMAIN=
SIP_USERNAME=
SIP_AUTH_USERNAME=
SIP_PASSWORD=
SIP_CALLER_ID=
SIP_ADVERTISED_IP=

# Asterisk AMI
ASTERISK_AMI_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=smartboot
ASTERISK_AMI_PASSWORD=

# Discord administrators
ADMIN_DISCORD_IDS=
ADMIN_ROLE_IDS=
